<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <renamePsiElementProcessor
            id="HikageView"
            order="first"
            implementation="com.highcapable.hikage.refactoring.view.HikageViewRenameProcessor"/>
        <renamePsiElementProcessor
            id="HikageLayoutId"
            order="first"
            implementation="com.highcapable.hikage.refactoring.layout.HikageLayoutIdRenameProcessor"/>
        <vetoRenameCondition implementation="com.highcapable.hikage.refactoring.view.PerformerRenameVetoCondition"/>
        <renameHandler
            order="last"
            implementation="com.highcapable.hikage.refactoring.attribute.HikageAttributeRenameHandler"/>
    </extensions>

    <actions>
        <action
            id="com.highcapable.hikage.rename"
            class="com.highcapable.hikage.refactoring.HikageRenameAction"
            use-shortcut-of="RenameElement"/>
    </actions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <renameHandler
            order="first"
            implementation="com.highcapable.hikage.refactoring.layout.HikageLayoutIdRenameHandler"/>
        <renameHandler
            order="first"
            implementation="com.highcapable.hikage.refactoring.view.HikageViewRenameHandler"/>
    </extensions>
</idea-plugin>