<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.android</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            id="com.highcapable.hikage.intellij.settings"
            parentId="language"
            provider="com.highcapable.hikage.intellij.settings.RootConfigurableProvider"
            nonDefaultProject="true"
            key="settings.page.name"
            bundle="messages.SettingsBundle"/>
        <projectConfigurable
            id="com.highcapable.hikage.intellij.settings.completion"
            parentId="com.highcapable.hikage.intellij.settings"
            instance="com.highcapable.hikage.intellij.settings.CompletionConfigurable"
            nonDefaultProject="true"
            key="settings.page.completion"
            bundle="messages.SettingsBundle"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/HikagableColorSchemeDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/HikagableColorSchemeDarcula.xml"/>

        <problemHighlightFilter implementation="com.highcapable.hikage.intellij.dsl.PerformerResolveProblemHighlightFilter"/>
        <java.elementFinder implementation="com.highcapable.hikage.intellij.dsl.PerformerPackageElementFinder"/>
        <referencesSearch implementation="com.highcapable.hikage.intellij.dsl.PerformerUsageSearcher"/>
        <renamePsiElementProcessor
            id="HikageView"
            order="first"
            implementation="com.highcapable.hikage.intellij.dsl.rename.HikageViewRenameProcessor"/>
        <vetoRenameCondition implementation="com.highcapable.hikage.intellij.dsl.rename.PerformerRenameVetoCondition"/>

        <localInspection
            language="kotlin"
            shortName="HikagableNaming"
            displayName="Hikagable declaration naming"
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikagableNamingInspection"/>
        <localInspection
            language="kotlin"
            shortName="HikagePerformerDeclaration"
            displayName="Invalid Hikage performer declaration"
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.PerformerDeclarationInspection"/>
        <localInspection
            language="kotlin"
            shortName="HikageUnnecessaryPerformer"
            displayName="Unnecessary Hikage performer parameter"
            groupName="Kotlin"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.UnnecessaryPerformerInspection"/>
        <lang.inspectionSuppressor
            language="kotlin"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikagableInspectionSuppressor"/>

        <!--suppress PluginXmlValidity -->
        <lookup.customizer implementation="com.highcapable.hikage.intellij.completion.HikagableLookupCustomizer"/>
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="com.highcapable.hikage.intellij.completion.HikagableCompletionContributor"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode
            supportsK1="false"
            supportsK2="true"/>
        <renameHandler
            order="first"
            implementation="com.highcapable.hikage.intellij.dsl.rename.HikageViewRenameHandler"/>
        <kaResolveExtensionProvider implementation="com.highcapable.hikage.intellij.dsl.PerformerResolveExtensionProvider"/>
        <callHighlighterExtension implementation="com.highcapable.hikage.intellij.highlighting.HikagableFunctionCallHighlighterExtension"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="com.highcapable.hikage.intellij.project.model.gradle.resolver.HikageGradleProjectResolver"/>
    </extensions>
</idea-plugin>