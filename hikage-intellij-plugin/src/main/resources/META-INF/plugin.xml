<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.android</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            id="com.highcapable.hikage.intellij.settings"
            parentId="language"
            provider="com.highcapable.hikage.intellij.settings.RootConfigurableProvider"
            nonDefaultProject="true"
            key="settings.page.name"
            bundle="messages.SettingsBundle"/>
        <projectConfigurable
            id="com.highcapable.hikage.intellij.settings.completion"
            parentId="com.highcapable.hikage.intellij.settings"
            instance="com.highcapable.hikage.intellij.settings.CompletionConfigurable"
            nonDefaultProject="true"
            key="settings.page.completion"
            bundle="messages.SettingsBundle"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/HikagableColorSchemeDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/HikagableColorSchemeDarcula.xml"/>

        <problemHighlightFilter implementation="com.highcapable.hikage.intellij.dsl.PerformerResolveProblemHighlightFilter"/>
        <java.elementFinder implementation="com.highcapable.hikage.intellij.dsl.PerformerPackageElementFinder"/>
        <referencesSearch implementation="com.highcapable.hikage.intellij.dsl.PerformerUsageSearcher"/>
        <renamePsiElementProcessor
            id="HikageView"
            order="first"
            implementation="com.highcapable.hikage.intellij.dsl.rename.HikageViewRenameProcessor"/>
        <vetoRenameCondition implementation="com.highcapable.hikage.intellij.dsl.rename.PerformerRenameVetoCondition"/>

        <localInspection
            language="kotlin"
            shortName="HikagableNaming"
            displayName="Hikagable declaration naming"
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikagableNamingInspection"/>
        <localInspection
            language="kotlin"
            shortName="HikagePerformerDeclaration"
            displayName="Invalid Hikage performer declaration"
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.PerformerDeclarationInspection"/>
        <localInspection
            language="kotlin"
            shortName="HikageUnnecessaryPerformer"
            displayName="Unnecessary Hikage performer parameter"
            groupName="Kotlin"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.UnnecessaryPerformerInspection"/>
        <localInspection
            language="kotlin"
            shortName="MissingHikageRuntimeAttributeDependency"
            displayName="Hikage runtime attribute dependency missing."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$MissingHikageRuntimeAttributeDependency"/>
        <localInspection
            language="kotlin"
            shortName="MissingHikageAttributeNamespace"
            displayName="Hikage attribute missing namespace."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$MissingHikageAttributeNamespace"/>
        <localInspection
            language="kotlin"
            shortName="DuplicateHikageAttribute"
            displayName="Hikage attribute duplicate."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$DuplicateHikageAttribute"/>
        <localInspection
            language="kotlin"
            shortName="ReplaceWithHikageAttributeNamespaceShortcuts"
            displayName="Hikage attribute namespace usage."
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$ReplaceWithHikageAttributeNamespaceShortcuts"/>
        <localInspection
            language="kotlin"
            shortName="IneffectiveHikageLayoutAttribute"
            displayName="Hikage layout attribute ineffective."
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$IneffectiveHikageLayoutAttribute"/>
        <localInspection
            language="kotlin"
            shortName="CreateIdInHikageAttribute"
            displayName="Hikage attribute creates ID resource."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$CreateIdInHikageAttribute"/>
        <localInspection
            language="kotlin"
            shortName="MissingIdInHikageAttribute"
            displayName="Hikage attribute ID resource missing."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$MissingIdInHikageAttribute"/>
        <localInspection
            language="kotlin"
            shortName="InvalidHikageAttributeName"
            displayName="Hikage attribute name invalid."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$InvalidHikageAttributeName"/>
        <localInspection
            language="kotlin"
            shortName="InvalidHikageAttributeResourceReference"
            displayName="Hikage attribute resource reference invalid."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$InvalidHikageAttributeResourceReference"/>
        <localInspection
            language="kotlin"
            shortName="InvalidHikageAttributeColorValue"
            displayName="Hikage attribute color value invalid."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$InvalidHikageAttributeColorValue"/>
        <localInspection
            language="kotlin"
            shortName="TooLongHikageAttributeString"
            displayName="Hikage attribute string too long."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageAttributeInspection$TooLongHikageAttributeString"/>
        <localInspection
            language="kotlin"
            shortName="HikagableBeyondScope"
            displayName="Hikagable beyond scope."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikagableBeyondScopeInspection"/>
        <localInspection
            language="kotlin"
            shortName="MissingHikagableAnnotation"
            displayName="Missing @Hikagable annotation."
            groupName="Kotlin"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikagablePropagationInspection"/>
        <localInspection
            language="kotlin"
            shortName="ReplaceWithHikageSafeTypeCast"
            displayName="Hikage safe type cast usage."
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikageSafeTypeCastInspection"/>
        <localInspection
            language="kotlin"
            shortName="UseHikageResourcesScope"
            displayName="Hikage resources scope violation."
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.ResourcesScopeInspection"/>
        <localInspection
            language="kotlin"
            shortName="RemoveHikagePerformerImportAlias"
            displayName="Hikage performer import alias."
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.PerformerImportAliasInspection"/>
        <localInspection
            language="kotlin"
            shortName="ReplaceWithGeneratedHikagePerformer"
            displayName="Hikage generated performer function usage."
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.highcapable.hikage.intellij.inspection.GeneratedPerformerInspection"/>
        <lang.inspectionSuppressor
            language="kotlin"
            implementationClass="com.highcapable.hikage.intellij.inspection.HikagableInspectionSuppressor"/>

        <!--suppress PluginXmlValidity -->
        <lookup.customizer implementation="com.highcapable.hikage.intellij.completion.HikagableLookupCustomizer"/>
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="com.highcapable.hikage.intellij.completion.HikagableCompletionContributor"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode
            supportsK1="false"
            supportsK2="true"/>
        <renameHandler
            order="first"
            implementation="com.highcapable.hikage.intellij.dsl.rename.HikageViewRenameHandler"/>
        <kaResolveExtensionProvider implementation="com.highcapable.hikage.intellij.dsl.PerformerResolveExtensionProvider"/>
        <callHighlighterExtension implementation="com.highcapable.hikage.intellij.highlighting.HikagableFunctionCallHighlighterExtension"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="com.highcapable.hikage.intellij.project.model.gradle.resolver.HikageGradleProjectResolver"/>
    </extensions>
</idea-plugin>