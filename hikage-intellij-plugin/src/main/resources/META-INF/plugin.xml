<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.spellchecker</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.android</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <spellchecker.bundledDictionaryProvider implementation="com.highcapable.hikage.spellchecker.HikageDictionaryProvider"/>
    </extensions>

    <xi:include href="completion.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="folding.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="highlighting.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="inspection.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="refactoring.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="resolution.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="settings.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <xi:include href="android-lint-mirror.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode
            supportsK1="false"
            supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="com.highcapable.hikage.project.model.gradle.resolver.HikageGradleProjectResolver"/>
    </extensions>
</idea-plugin>