<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <typedHandler
            order="first"
            implementation="com.highcapable.hikage.intellij.completion.HikageAttributeAutoPopupHandler"/>
        <typedHandler
            order="first"
            implementation="com.highcapable.hikage.intellij.completion.HikageLayoutIdAutoPopupHandler"/>

        <!--suppress PluginXmlValidity -->
        <lookup.customizer implementation="com.highcapable.hikage.intellij.completion.HikagableLookupCustomizer"/>
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="com.highcapable.hikage.intellij.completion.HikagableCompletionContributor"/>
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="com.highcapable.hikage.intellij.completion.HikageAttributeCompletionContributor"/>
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="com.highcapable.hikage.intellij.completion.HikageLayoutIdCompletionContributor"/>
        <completion.confidence
            id="hikageAttributeStrings"
            language="kotlin"
            order="before kotlinSkipAutopopupInStrings"
            implementationClass="com.highcapable.hikage.intellij.completion.HikageAttributeCompletionConfidence"/>
        <completion.confidence
            id="hikageLayoutIdStrings"
            language="kotlin"
            order="before kotlinSkipAutopopupInStrings"
            implementationClass="com.highcapable.hikage.intellij.completion.HikageLayoutIdCompletionConfidence"/>
    </extensions>
</idea-plugin>