<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            id="com.highcapable.hikage.settings"
            parentId="language"
            provider="com.highcapable.hikage.settings.provider.RootConfigurableProvider"
            nonDefaultProject="true"
            key="settings.page.name"
            bundle="messages.SettingsBundle"/>
        <projectConfigurable
            id="com.highcapable.hikage.settings.completion"
            parentId="com.highcapable.hikage.settings"
            provider="com.highcapable.hikage.settings.provider.CompletionConfigurableProvider"
            nonDefaultProject="true"
            key="settings.page.completion"
            bundle="messages.SettingsBundle"/>
        <projectConfigurable
            id="com.highcapable.hikage.settings.editor"
            parentId="com.highcapable.hikage.settings"
            provider="com.highcapable.hikage.settings.provider.EditorConfigurableProvider"
            nonDefaultProject="true"
            key="settings.page.editor"
            bundle="messages.SettingsBundle"/>
        <projectConfigurable
            id="com.highcapable.hikage.settings.inspection"
            parentId="com.highcapable.hikage.settings"
            provider="com.highcapable.hikage.settings.provider.InspectionConfigurableProvider"
            nonDefaultProject="true"
            key="settings.page.inspection"
            bundle="messages.SettingsBundle"/>
    </extensions>
</idea-plugin>