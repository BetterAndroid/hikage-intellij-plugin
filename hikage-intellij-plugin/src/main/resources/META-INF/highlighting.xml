<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <additionalTextAttributes scheme="Default" file="colorSchemes/HikageColorSchemeDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/HikageColorSchemeDarcula.xml"/>

        <lang.inspectionSuppressor
            language="kotlin"
            implementationClass="com.highcapable.hikage.inspection.suppressor.HikagableInspectionSuppressor"/>
        <annotator
            language="kotlin"
            implementationClass="com.highcapable.hikage.annotator.DeprecatedHikageAttributeAnnotator"/>
        <externalAnnotator
            language="kotlin"
            implementationClass="com.highcapable.hikage.annotator.HikageAttributeResourceExternalAnnotator"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <callHighlighterExtension implementation="com.highcapable.hikage.highlighting.HikageCallHighlighterExtension"/>
    </extensions>
</idea-plugin>